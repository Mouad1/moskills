#!/usr/bin/env sh
# moskills — portfolio standard manager (init | sync | doctor | notice)
# Managed files live under .claude/standard, .claude/commands, .claude/skills,
# .claude/hooks/agent-guard.sh and are OWNED by this tool (never hand-edit).
# Project-owned files (CLAUDE.md, STATE.md, tasks/) are seeded once, never overwritten.
set -eu

# resolve symlinks so a launcher in ~/.local/bin finds the real install
self=$0
while [ -L "$self" ]; do
  link_target=$(readlink "$self")
  case "$link_target" in
    /*) self=$link_target ;;
    *)  self=$(dirname "$self")/$link_target ;;
  esac
done
SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$self")" && pwd)
STANDARD_VERSION=$(cat "$SCRIPT_DIR/VERSION")
MANAGED_DIR="$SCRIPT_DIR/templates/managed"
LEGACY_DIR="$SCRIPT_DIR/templates/claude"
PROJECT_TPL="$SCRIPT_DIR/templates/project"

MARKER_BEGIN='<!-- moskills:begin (managed imports - do not edit inside markers) -->'
MARKER_END='<!-- moskills:end -->'

log()  { printf '%s\n' "$1"; }
warn() { printf 'WARN: %s\n' "$1"; }
die()  { printf 'Error: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: moskills <command> [options]

Commands:
  init    [--target <path>] [--with-hooks] [--agents]
                                            Install the standard into a project.
  sync    [--target <path>] [--force] [--agents]
                                            Upgrade managed files to the latest version.
  doctor  [--target <path>]                 Report drift (read-only, exit 1 on drift).
  notice  [--target <path>] [--hook]        One line if the project version differs
                                            from the plugin; silent otherwise. Never fails.
  version                                   Print the standard version.

Other agents (Antigravity, Codex):
  setup   [--yes]        Guided first run: link agents, replace old copies,
                         turn on daily updates. Safe to run again.
  status                 Version, linked agents, launcher, daily update.
  uninstall [--yes]      Remove links, daily update and a standalone install.
  link    [--replace]    Link moskills skills into every detected agent
                         (~/.gemini/config/skills, ~/.agents/skills) and add
                         the launcher ~/.local/bin/moskills.
  unlink                 Remove only the links created by link.
  self-update            git pull this install (clean main only), then link.
  schedule-update        macOS: run self-update daily via a LaunchAgent.

Multi-repo:
  init|sync|doctor --all <root>        Run against every subdirectory of <root>
                                       that contains .moskills.json (init: skipped).

Options:
  --force       sync only: overwrite managed files even if hand-edited.
  --with-hooks  init only: install the Git pre-commit wrapper that runs agent-guard.sh.
  --hook        notice only: print Claude Code SessionStart hook JSON instead of text.
  --agents      init/sync: also install skills in .agents/skills and a managed
                block in AGENTS.md (read by Antigravity, Codex, and others).
  --replace     link only: back up existing real skill folders, then link.
  --yes         setup/uninstall: accept every default without asking.
USAGE
}

sha() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
  else shasum -a 256 "$1" | awk '{print $1}'; fi
}

# ---------- managed file inventory (source|dest pairs) ----------
managed_pairs() {
  for f in "$MANAGED_DIR"/*.md; do
    [ -e "$f" ] || continue
    printf '%s|%s\n' "$f" ".claude/standard/$(basename "$f")"
  done
  find "$LEGACY_DIR/commands" -type f | while IFS= read -r f; do
    printf '%s|%s\n' "$f" ".claude/commands/${f#"$LEGACY_DIR/commands/"}"
  done
  find "$LEGACY_DIR/skills" -type f | while IFS= read -r f; do
    printf '%s|%s\n' "$f" ".claude/skills/${f#"$LEGACY_DIR/skills/"}"
  done
  printf '%s|%s\n' "$LEGACY_DIR/hooks/agent-guard.sh" ".claude/hooks/agent-guard.sh"
  if [ "$AGENTS_ON" -eq 1 ]; then
    find "$LEGACY_DIR/skills" -type f | while IFS= read -r f; do
      printf '%s|%s\n' "$f" ".agents/skills/${f#"$LEGACY_DIR/skills/"}"
    done
  fi
}

SUM_FILE='.claude/standard/.manifest.sum'

write_sums() { # $1 = target
  t=$1
  : > "$t/$SUM_FILE.tmp"
  managed_pairs | while IFS='|' read -r src dest; do
    [ -f "$t/$dest" ] || continue
    printf '%s  %s\n' "$(sha "$t/$dest")" "$dest" >> "$t/$SUM_FILE.tmp"
  done
  mv "$t/$SUM_FILE.tmp" "$t/$SUM_FILE"
}

write_manifest() { # $1 = target
  cat > "$1/.moskills.json" <<EOF
{
  "standard": "moskills",
  "version": "$STANDARD_VERSION",
  "layout": "1",
  "agents": $(if [ "$AGENTS_ON" -eq 1 ]; then echo true; else echo false; fi),
  "updated": "$(date +%Y-%m-%d)"
}
EOF
}

manifest_version() { # $1 = target
  sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' "$1/.moskills.json" 2>/dev/null | head -1
}

manifest_agents() { # $1 = target — prints 1 when the project opted into other agents
  if grep -q '"agents": *true' "$1/.moskills.json" 2>/dev/null; then echo 1; else echo 0; fi
}

# ---------- CLAUDE.md marker block ----------
marker_block() { # imports every managed standard file, so new files need no CLI change
  printf '%s\n' "$MARKER_BEGIN"
  for f in "$MANAGED_DIR"/*.md; do
    [ -e "$f" ] || continue
    printf '@.claude/standard/%s\n' "$(basename "$f")"
  done
  printf '%s\n' "$MARKER_END"
}

agents_block() { # AGENTS.md has no @imports, so name the files to read
  printf '%s\n' "$MARKER_BEGIN"
  printf 'This project follows the moskills standard. Before any task, read:\n'
  for f in "$MANAGED_DIR"/*.md; do
    [ -e "$f" ] || continue
    printf -- '- .claude/standard/%s\n' "$(basename "$f")"
  done
  printf 'Project skills live in .agents/skills/.\n'
  printf 'At session start, if the moskills command is available, run `moskills notice` and tell the user any line it prints.\n'
  printf '%s\n' "$MARKER_END"
}

ensure_marker() { # $1 = target
  ensure_block "$1/CLAUDE.md" marker_block 0
  [ "$AGENTS_ON" -eq 1 ] && ensure_block "$1/AGENTS.md" agents_block 1
  return 0
}

ensure_block() { # $1 = file, $2 = block function, $3 = 1 to create the file when missing
  cm=$1
  if [ ! -f "$cm" ]; then
    [ "$3" -eq 1 ] || return 0
    "$2" > "$cm"
    log "Created $(basename "$cm") with managed block"
    return 0
  fi
  if grep -q 'moskills:begin' "$cm"; then
    "$2" > "$cm.blk"
    awk -v blkfile="$cm.blk" '
      index($0,"moskills:begin") { while ((getline line < blkfile) > 0) print line; inblk=1; next }
      index($0,"moskills:end")   { inblk=0; next }
      !inblk { print }
    ' "$cm" > "$cm.tmp" && mv "$cm.tmp" "$cm"
    rm -f "$cm.blk"
  else
    { printf '\n'; "$2"; } >> "$cm"
    log "Added managed block to $(basename "$cm")"
  fi
}

# ---------- install / seed ----------
install_managed() { # $1 = target
  t=$1
  managed_pairs | while IFS='|' read -r src dest; do
    mkdir -p "$t/$(dirname "$dest")"
    cp "$src" "$t/$dest"
  done
  chmod +x "$t/.claude/hooks/agent-guard.sh" 2>/dev/null || true
  write_sums "$t"
}

seed_one() { # $1 src, $2 dest — copy only if missing
  if [ -e "$2" ]; then log "Keep existing: ${2#"$TARGET/"}"; else
    mkdir -p "$(dirname "$2")"; cp "$1" "$2"; log "Seeded: ${2#"$TARGET/"}"
  fi
}

seed_project() { # $1 = target
  t=$1
  seed_one "$PROJECT_TPL/CLAUDE.md"            "$t/CLAUDE.md"
  seed_one "$PROJECT_TPL/STATE.md"             "$t/.claude/STATE.md"
  seed_one "$PROJECT_TPL/settings.local.json"  "$t/.claude/settings.local.json"
  seed_one "$PROJECT_TPL/tasks/todo.md"        "$t/tasks/todo.md"
  seed_one "$PROJECT_TPL/tasks/lessons.md"     "$t/tasks/lessons.md"
}

install_git_hook() { # $1 = target — pre-commit wrapper running agent-guard.sh
  t=$1
  [ "$WITH_HOOKS" -eq 1 ] || return 0
  if ! git -C "$t" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    log 'Skip Git hook install: target is not a Git repository'
    return 0
  fi
  hook_path=$(git -C "$t" rev-parse --git-path hooks/pre-commit)
  case "$hook_path" in
    /*) hook_dest=$hook_path ;;
    *)  hook_dest=$t/$hook_path ;;
  esac
  if [ -e "$hook_dest" ]; then
    log "Skip existing Git hook: $hook_dest"
    return 0
  fi
  mkdir -p "$(dirname "$hook_dest")"
  cp "$LEGACY_DIR/hooks/pre-commit" "$hook_dest"
  chmod +x "$hook_dest"
  log "Installed Git pre-commit hook: $hook_dest"
}

ensure_gitignore() { # $1 = target — keep seeded local settings out of git
  t=$1
  entry='.claude/settings.local.json'
  [ -e "$t/.git" ] || return 0
  gi="$t/.gitignore"
  if [ -f "$gi" ]; then
    grep -qxF "$entry" "$gi" && return 0
    [ -n "$(tail -c 1 "$gi")" ] && printf '\n' >> "$gi"
    printf '%s\n' "$entry" >> "$gi"
  else
    printf '%s\n' "$entry" > "$gi"
  fi
  log "Added $entry to .gitignore"
}

# ---------- drift check ----------
# prints: "edited <dest>" / "missing <dest>" lines; returns 0 always
drift_lines() { # $1 = target
  t=$1
  [ -f "$t/$SUM_FILE" ] || return 0
  while IFS= read -r line; do
    expected=${line%%  *}
    dest=${line#*  }
    if [ ! -f "$t/$dest" ]; then printf 'missing %s\n' "$dest"
    elif [ "$(sha "$t/$dest")" != "$expected" ]; then printf 'edited %s\n' "$dest"
    fi
  done < "$t/$SUM_FILE"
}

# ---------- commands ----------
cmd_init() {
  t=$TARGET
  AGENTS_ON=$AGENTS
  [ -d "$t" ] || die "target does not exist: $t"
  log "Installing moskills standard v$STANDARD_VERSION into $t"
  install_managed "$t"
  seed_project "$t"
  ensure_gitignore "$t"
  install_git_hook "$t"
  ensure_marker "$t"
  write_manifest "$t"
  if [ "$AGENTS_ON" -ne 1 ] && { [ -f "$t/AGENTS.md" ] || [ -n "$(agent_targets)" ]; }; then
    log "Tip: Antigravity, Codex and other agents can use moskills too. Run: moskills sync --agents --target $t"
  fi
  log "Done. Next: edit CLAUDE.md 'Project constraints' section, then run: moskills doctor --target $t"
}

cmd_sync() {
  t=$TARGET
  [ -f "$t/.moskills.json" ] || die "no .moskills.json in $t — run 'moskills init' first"
  from=$(manifest_version "$t")
  AGENTS_ON=$AGENTS
  [ "$(manifest_agents "$t")" -eq 1 ] && AGENTS_ON=1
  log "Sync $t: v$from -> v$STANDARD_VERSION"

  skipped=0
  drift=$(drift_lines "$t")
  if [ -n "$drift" ] && [ "$FORCE" -ne 1 ]; then
    printf '%s\n' "$drift" | while IFS=' ' read -r kind dest; do
      if [ "$kind" = "edited" ]; then warn "hand-edited managed file kept (use --force to overwrite): $dest"; fi
    done
    skipped=1
  fi

  # run migrations between majors, if any
  from_major=${from%%.*}; to_major=${STANDARD_VERSION%%.*}
  if [ "$from_major" != "$to_major" ] && [ -f "$SCRIPT_DIR/migrations/v$from_major-to-v$to_major.sh" ]; then
    log "Running migration v$from_major -> v$to_major"
    sh "$SCRIPT_DIR/migrations/v$from_major-to-v$to_major.sh" "$t"
  fi

  if [ "$FORCE" -eq 1 ] || [ "$skipped" -eq 0 ]; then
    install_managed "$t"
  else
    # update only non-edited files
    edited_list=$(printf '%s\n' "$drift" | awk '$1=="edited"{print $2}')
    managed_pairs | while IFS='|' read -r src dest; do
      case "$edited_list" in *"$dest"*) continue ;; esac
      mkdir -p "$t/$(dirname "$dest")"; cp "$src" "$t/$dest"
    done
    chmod +x "$t/.claude/hooks/agent-guard.sh" 2>/dev/null || true
    # keep old sums for edited files so doctor keeps flagging them
    tmp="$t/$SUM_FILE.new"; : > "$tmp"
    managed_pairs | while IFS='|' read -r src dest; do
      [ -f "$t/$dest" ] || continue
      case "$edited_list" in
        *"$dest"*) grep "  $dest\$" "$t/$SUM_FILE" >> "$tmp" || true ;;
        *) printf '%s  %s\n' "$(sha "$t/$dest")" "$dest" >> "$tmp" ;;
      esac
    done
    mv "$tmp" "$t/$SUM_FILE"
  fi

  ensure_gitignore "$t"
  ensure_marker "$t"
  write_manifest "$t"
  log "Sync complete."
}

cmd_doctor() {
  t=$TARGET
  issues=0
  name=$(basename "$t")
  if [ ! -f "$t/.moskills.json" ]; then
    printf '%-20s NOT INSTALLED (run: moskills init --target %s)\n' "$name" "$t"
    return 1
  fi
  v=$(manifest_version "$t")
  if [ "$v" != "$STANDARD_VERSION" ]; then
    printf '%-20s OUTDATED  v%s (latest v%s) -> run moskills sync\n' "$name" "$v" "$STANDARD_VERSION"
    issues=1
  fi
  drift=$(drift_lines "$t")
  if [ -n "$drift" ]; then
    printf '%s\n' "$drift" | while IFS=' ' read -r kind dest; do
      printf '%-20s %s managed file: %s\n' "$name" "$kind" "$dest"
    done
    issues=1
  fi
  for req in CLAUDE.md .claude/STATE.md tasks/todo.md tasks/lessons.md; do
    if [ ! -f "$t/$req" ]; then
      printf '%-20s missing project file: %s\n' "$name" "$req"
      issues=1
    fi
  done
  if [ -f "$t/CLAUDE.md" ] && ! grep -q 'moskills:begin' "$t/CLAUDE.md"; then
    printf '%-20s CLAUDE.md missing managed import block\n' "$name"
    issues=1
  fi
  if [ "$(manifest_agents "$t")" -eq 1 ] && ! grep -q 'moskills:begin' "$t/AGENTS.md" 2>/dev/null; then
    printf '%-20s AGENTS.md missing managed block (run moskills sync)\n' "$name"
    issues=1
  fi
  [ "$issues" -eq 0 ] && printf '%-20s OK  v%s\n' "$name" "$v"
  return "$issues"
}

# ---------- version notice (session start) ----------
version_lt() { # $1 < $2 for dotted numeric versions
  awk -v a="$1" -v b="$2" 'BEGIN {
    na = split(a, x, "."); nb = split(b, y, "."); n = (na > nb) ? na : nb
    for (i = 1; i <= n; i++) {
      if ((x[i] + 0) < (y[i] + 0)) exit 0
      if ((x[i] + 0) > (y[i] + 0)) exit 1
    }
    exit 1
  }'
}

cmd_notice() {
  t=$TARGET
  [ -f "$t/.moskills.json" ] || return 0
  v=$(manifest_version "$t")
  [ -n "$v" ] && [ "$v" != "$STANDARD_VERSION" ] || return 0
  if version_lt "$v" "$STANDARD_VERSION"; then
    msg="moskills standard v$v is older than the plugin v$STANDARD_VERSION: run /moskills-sync"
  else
    msg="moskills standard v$v is newer than the plugin v$STANDARD_VERSION: update the moskills plugin"
  fi
  if [ "$HOOK" -eq 1 ]; then
    printf '{"systemMessage": "%s", "hookSpecificOutput": {"hookEventName": "SessionStart", "additionalContext": "%s. Tell the user before starting work."}}\n' "$msg" "$msg"
  else
    log "$msg"
  fi
  return 0
}

# ---------- other agents (global links) ----------
agent_targets() { # prints "agent|skills dir" for each detected agent
  if [ -d "$HOME/.gemini" ]; then printf 'antigravity|%s\n' "$HOME/.gemini/config/skills"; fi
  if [ -d "$HOME/.agents" ] || [ -d "$HOME/.codex" ]; then printf 'codex|%s\n' "$HOME/.agents/skills"; fi
}

link_path() { # $1 = source, $2 = link path, $3 = agent (for backups)
  if [ -L "$2" ]; then
    rm "$2"
  elif [ -e "$2" ]; then
    if [ "$REPLACE" -ne 1 ]; then
      warn "kept existing folder $2 (rerun with --replace to back it up and link)"
      return 0
    fi
    bk="$HOME/.moskills-backups/$3/$(basename "$2")-$(date +%Y%m%d%H%M%S)"
    mkdir -p "$(dirname "$bk")"
    mv "$2" "$bk"
    log "Backed up $2 -> $bk"
  fi
  ln -s "$1" "$2"
}

cmd_link() {
  found=0
  agents=$(agent_targets)
  if [ -n "$agents" ]; then
    printf '%s\n' "$agents" | while IFS='|' read -r agent dir; do
      mkdir -p "$dir"
      for sk in "$LEGACY_DIR"/skills/*/; do
        sk=${sk%/}
        link_path "$sk" "$dir/$(basename "$sk")" "$agent"
      done
      log "Linked moskills skills for $agent: $dir"
    done
  else
    log 'No other agents found (looked for ~/.gemini, ~/.agents, ~/.codex).'
  fi
  install_launcher
}

install_launcher() {
  launcher="$HOME/.local/bin/moskills"
  if [ -e "$launcher" ] && [ ! -L "$launcher" ]; then
    warn "kept existing file $launcher (not a moskills link)"
  else
    mkdir -p "$(dirname "$launcher")"
    rm -f "$launcher"
    ln -s "$SCRIPT_DIR/moskills" "$launcher"
    log "Launcher: $launcher (make sure ~/.local/bin is on PATH)"
  fi
}

cmd_unlink() {
  for dir in "$HOME/.gemini/config/skills" "$HOME/.agents/skills"; do
    [ -d "$dir" ] || continue
    for entry in "$dir"/*; do
      [ -L "$entry" ] || continue
      case "$(readlink "$entry")" in "$SCRIPT_DIR"/*) rm "$entry" ;; esac
    done
  done
  launcher="$HOME/.local/bin/moskills"
  if [ -L "$launcher" ]; then
    case "$(readlink "$launcher")" in "$SCRIPT_DIR"/*) rm "$launcher" ;; esac
  fi
  log 'Removed moskills links.'
}

cmd_self_update() {
  git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || die "not a git checkout: $SCRIPT_DIR (install with: git clone https://github.com/Mouad1/moskills ~/.moskills)"
  branch=$(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD)
  [ "$branch" = main ] || die "self-update only runs on main (current branch: $branch)"
  [ -z "$(git -C "$SCRIPT_DIR" status --porcelain --untracked-files=no)" ] || die "local changes in $SCRIPT_DIR, refusing to update"
  git -C "$SCRIPT_DIR" pull --ff-only --quiet || die 'git pull failed'
  log "moskills v$STANDARD_VERSION -> v$(cat "$SCRIPT_DIR/VERSION")"
  sh "$SCRIPT_DIR/moskills" link
}

cmd_schedule_update() {
  plist="$HOME/Library/LaunchAgents/com.moskills.self-update.plist"
  mkdir -p "$(dirname "$plist")"
  cat > "$plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.moskills.self-update</string>
  <key>ProgramArguments</key>
  <array><string>/bin/sh</string><string>$SCRIPT_DIR/moskills</string><string>self-update</string></array>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>9</integer><key>Minute</key><integer>15</integer></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/moskills-self-update.log</string>
  <key>StandardErrorPath</key><string>/tmp/moskills-self-update.log</string>
</dict>
</plist>
EOF
  if [ "${MOSKILLS_NO_LAUNCHCTL:-0}" != 1 ] && command -v launchctl >/dev/null 2>&1; then
    launchctl unload "$plist" 2>/dev/null || true
    launchctl load "$plist"
  fi
  log "Daily self-update scheduled: $plist (log: /tmp/moskills-self-update.log)"
  log "Remove with: launchctl unload $plist && rm $plist"
}

# ---------- guided setup / status / uninstall ----------
open_input() { # answers come from MOSKILLS_TTY (tests), the terminal, or nowhere
  NO_TTY=0
  if [ -n "${MOSKILLS_TTY:-}" ]; then exec 3<"$MOSKILLS_TTY"
  elif (exec 3</dev/tty) 2>/dev/null; then exec 3</dev/tty
  else NO_TTY=1
  fi
}

ask() { # $1 = question; default yes; returns 0 for yes
  if [ "$YES" -eq 1 ] || [ "$NO_TTY" -eq 1 ]; then
    log "$1 [Y/n] yes"
    return 0
  fi
  printf '%s [Y/n] ' "$1"
  ans=''
  read -r ans <&3 || ans=''
  case "$ans" in n|N|no|No|NO) return 1 ;; *) return 0 ;; esac
}

is_git_install() { git -C "$SCRIPT_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; }

old_copies() { # counts real folders that block links
  n=0
  agents=$(agent_targets)
  [ -n "$agents" ] || { echo 0; return 0; }
  for dir in $(printf '%s\n' "$agents" | cut -d'|' -f2); do
    for sk in "$LEGACY_DIR"/skills/*/; do
      d="$dir/$(basename "$sk")"
      if [ -e "$d" ] && [ ! -L "$d" ]; then n=$((n + 1)); fi
    done
  done
  echo "$n"
}

cmd_setup() {
  open_input
  log "moskills v$STANDARD_VERSION setup ($SCRIPT_DIR)"
  agents=$(agent_targets)
  if [ -z "$agents" ]; then
    log 'No other agents found (looked for ~/.gemini, ~/.agents, ~/.codex). Claude Code users: install the plugin, see the README.'
  else
    names=$(printf '%s\n' "$agents" | cut -d'|' -f1 | tr '\n' ' ' | sed 's/ $//; s/ /, /g')
    if ask "Link moskills to: $names?"; then
      old=$(old_copies)
      if [ "$old" -gt 0 ] && ask "Found $old old copies of moskills skills. Back them up and replace them?"; then
        REPLACE=1
      fi
      cmd_link
      linked=1
    fi
  fi
  [ "${linked:-0}" -eq 1 ] || install_launcher
  if ! is_git_install; then
    log 'Automatic updates need git. To update, run the install line again.'
  elif [ "$(uname)" = Darwin ]; then
    if ask 'Update moskills automatically every day?'; then cmd_schedule_update; fi
  else
    log "Automatic updates: add this line to crontab -e: 15 9 * * * sh $SCRIPT_DIR/moskills self-update"
  fi
  log ''
  log 'Next: in a project, run: moskills init --agents'
  log 'Check anytime: moskills status'
}

cmd_status() {
  log "Version: $STANDARD_VERSION"
  if is_git_install; then
    log "Installed in: $SCRIPT_DIR (git, branch $(git -C "$SCRIPT_DIR" rev-parse --abbrev-ref HEAD))"
  else
    log "Installed in: $SCRIPT_DIR"
  fi
  for pair in "antigravity|$HOME/.gemini/config/skills" "codex|$HOME/.agents/skills"; do
    agent=${pair%%|*}; dir=${pair#*|}
    if [ ! -d "$dir" ]; then log "$agent: not installed"; continue; fi
    n=0
    for entry in "$dir"/*; do
      [ -L "$entry" ] || continue
      case "$(readlink "$entry")" in "$SCRIPT_DIR"/*) n=$((n + 1)) ;; esac
    done
    log "$agent: $n skills linked ($dir)"
  done
  if command -v moskills >/dev/null 2>&1; then log "Command: $(command -v moskills)"
  else log 'Command: moskills is not on PATH (add ~/.local/bin to PATH)'
  fi
  plist="$HOME/Library/LaunchAgents/com.moskills.self-update.plist"
  if [ -f "$plist" ]; then
    last='never'
    [ -f /tmp/moskills-self-update.log ] && last=$(date -r /tmp/moskills-self-update.log '+%Y-%m-%d %H:%M')
    log "Daily update: on (last run: $last)"
  else
    log 'Daily update: off'
  fi
}

cmd_uninstall() {
  open_input
  ask "Remove moskills links, the daily update and $SCRIPT_DIR?" || { log 'Nothing removed.'; return 0; }
  cmd_unlink
  plist="$HOME/Library/LaunchAgents/com.moskills.self-update.plist"
  if [ -f "$plist" ]; then
    if [ "${MOSKILLS_NO_LAUNCHCTL:-0}" != 1 ] && command -v launchctl >/dev/null 2>&1; then
      launchctl unload "$plist" 2>/dev/null || true
    fi
    rm -f "$plist"
    log 'Daily update removed.'
  fi
  if [ -f "$SCRIPT_DIR/.moskills-standalone" ] && [ "$SCRIPT_DIR" != "$HOME" ] && [ "$SCRIPT_DIR" != / ]; then
    rm -rf "$SCRIPT_DIR"
    log "Removed $SCRIPT_DIR"
  else
    log "Install folder kept: $SCRIPT_DIR (not a standalone install, delete it yourself if you want)"
  fi
  log 'Claude Code plugin, if installed: /plugin uninstall moskills@moskills'
}

# ---------- arg parsing ----------
[ "$#" -ge 1 ] || { usage; exit 1; }
CMD=$1; shift
TARGET=$(pwd)
FORCE=0
WITH_HOOKS=0
HOOK=0
AGENTS=0
AGENTS_ON=0
REPLACE=0
YES=${MOSKILLS_YES:-0}
NO_TTY=0
ALL_ROOT=''

while [ "$#" -gt 0 ]; do
  case "$1" in
    --target) [ "$#" -ge 2 ] || die '--target requires a path'; TARGET=$2; shift 2 ;;
    --all)    [ "$#" -ge 2 ] || die '--all requires a root path'; ALL_ROOT=$2; shift 2 ;;
    --force)  FORCE=1; shift ;;
    --with-hooks) WITH_HOOKS=1; shift ;;
    --hook)   HOOK=1; shift ;;
    --agents) AGENTS=1; shift ;;
    --replace) REPLACE=1; shift ;;
    --yes)    YES=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
done

run_all() { # $1 = command function
  rc=0
  for d in "$ALL_ROOT"/*/; do
    [ -f "$d/.moskills.json" ] || continue
    TARGET=${d%/}
    "$1" || rc=1
  done
  return "$rc"
}

case "$CMD" in
  version) log "$STANDARD_VERSION" ;;
  init)    [ -n "$ALL_ROOT" ] && die 'init does not support --all (install per repo deliberately)'; cmd_init ;;
  sync)    if [ -n "$ALL_ROOT" ]; then run_all cmd_sync; else cmd_sync; fi ;;
  doctor)  if [ -n "$ALL_ROOT" ]; then run_all cmd_doctor; else cmd_doctor; fi ;;
  notice)  cmd_notice ;;
  link)    cmd_link ;;
  setup)   cmd_setup ;;
  status)  cmd_status ;;
  uninstall) cmd_uninstall ;;
  unlink)  cmd_unlink ;;
  self-update)     cmd_self_update ;;
  schedule-update) cmd_schedule_update ;;
  *) usage; exit 1 ;;
esac
